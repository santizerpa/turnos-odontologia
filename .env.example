# Perfil de ejecución
SPRING_PROFILES_ACTIVE=local

# PostgreSQL local (obligatorias en perfil local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/odontologia
SPRING_DATASOURCE_USERNAME=odontologia
SPRING_DATASOURCE_PASSWORD=local-only

# Usuario inicial ficticio (obligatorio desde C-03)
APP_ADMIN_EMAIL=demo@odontologia.local
APP_ADMIN_PASSWORD=demo-segura-123
APP_ADMIN_SEED=true

# Conjunto completo de demo (opt-in; requiere APP_ADMIN_SEED=true y una base local limpia)
APP_DEMO_SEED=false

# Reservadas: la versión actual no las lee (los enlaces de la bandeja son relativos
# y el token vence al inicio del turno o a los 7 días).
APP_PUBLIC_URL=http://localhost:8080
APP_TOKEN_MAX_DAYS=7

# Solo para el PRIMER arranque sobre una base vacía (ver README, sección 3.4).
# Después hay que quitarla para volver a ddl-auto=validate.
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
